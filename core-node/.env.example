# /etc/core-node.env
# chmod 600, chown opc:opc

# ── API Gateway ──────────────────────────────────────────────────────────────
WORKER_URL=https://api.arb.bagow.com

# ── Database paths ───────────────────────────────────────────────────────────
PROFILES_DB_PATH=/home/opc/vps-api/vps-api.db
REAL_DB_PATH=/home/opc/core-node/real-trader.db
PAPER_DB_PATH=/home/opc/core-node/paper-trader.db

# ── HTTP API port (dashboard passthrough) ────────────────────────────────────
PORT=3003

# ── CRITICAL: set to false only after smoke test in DRY_RUN=true ────────────
DRY_RUN=true

# ── Gate.io — whitelist IP: 140.238.172.212 ─────────────────────────────────
GATE_KEY=
GATE_SECRET=

# ── HTX / Huobi — whitelist IP: 140.238.172.212 ─────────────────────────────
HTX_KEY=
HTX_SECRET=

# ── KuCoin — whitelist IP: 140.238.172.212 ──────────────────────────────────
KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
