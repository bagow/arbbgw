# /etc/core-node.env
# chmod 640, chown root:opc

# ── Database paths ───────────────────────────────────────────────────────────
# MUST MATCH the paths used by vps-api.service (both services share same DBs)
PROFILES_DB_PATH=/home/opc/core-node/vps-api.db
REAL_DB_PATH=/home/opc/core-node/real-trader.db
PAPER_DB_PATH=/home/opc/core-node/paper-trader.db

# ── HTTP API port (dashboard passthrough) ────────────────────────────────────
PORT=3003

# ── CRITICAL: set to false only after smoke test in DRY_RUN=true ────────────
DRY_RUN=true

# ── Gate.io ──────────────────────────────────────────────────────────────────
GATE_KEY=
GATE_SECRET=

# ── KuCoin ───────────────────────────────────────────────────────────────────
KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_KEY=
BINANCE_SECRET=

# ── Bybit ─────────────────────────────────────────────────────────────────────
BYBIT_KEY=
BYBIT_SECRET=

# ── Bitget ────────────────────────────────────────────────────────────────────
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

# ── BingX ─────────────────────────────────────────────────────────────────────
BINGX_KEY=
BINGX_SECRET=

# ── BitMEX ────────────────────────────────────────────────────────────────────
BITMEX_KEY=
BITMEX_SECRET=

# ── AscendEX ──────────────────────────────────────────────────────────────────
ASCENDEX_KEY=
ASCENDEX_SECRET=

# ── XT.COM ────────────────────────────────────────────────────────────────────
XT_KEY=
XT_SECRET=

# ── Toobit ────────────────────────────────────────────────────────────────────
TOOBIT_KEY=
TOOBIT_SECRET=

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
