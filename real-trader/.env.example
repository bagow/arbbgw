# real-trader environment variables
# Copy to .env and fill in real values

# Cloudflare Worker URL (for pushing trade state to dashboard - NOT used for settings anymore)
WORKER_URL=https://api.arb.bagow.com

# Path to vps-api.db (profiles / settings). real-trader reads settings directly
# from this file instead of calling Cloudflare, giving nanosecond latency.
# On the server, this should point to the vps-api working directory.
PROFILES_DB_PATH=/home/opc/vps-api/vps-api.db

# Token the rust-collector uses to send spreads to this service
# Must match INTERNAL_TOKEN in rust-collector .env
INTERNAL_TOKEN=your-internal-token-here

# Token for pushing active/closed trades to Cloudflare Worker
# Must match COLLECTOR_TOKEN in Worker
COLLECTOR_TOKEN=your-collector-token-here

# Port to listen on
REAL_TRADER_PORT=3002

# Set to "false" to enable REAL order placement. Default is true (dry-run only).
DRY_RUN=true

# Gate.io API v4 Futures
GATE_KEY=YOUR_GATE_API_KEY
GATE_SECRET=YOUR_GATE_API_SECRET

# HTX (Huobi) Linear Swap
HTX_KEY=YOUR_HTX_API_KEY
HTX_SECRET=YOUR_HTX_API_SECRET

# KuCoin Futures
KUCOIN_KEY=YOUR_KUCOIN_API_KEY
KUCOIN_SECRET=YOUR_KUCOIN_API_SECRET
KUCOIN_PASSPHRASE=YOUR_KUCOIN_PASSPHRASE

# Logging
RUST_LOG=info
