[Unit]
Description=CEX Spread Scanner API Server
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/vps-api
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/etc/cex-api.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
