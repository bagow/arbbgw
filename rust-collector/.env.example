# Rust Collector – Environment Variables
# Copy to .env and fill in your values

# ── Required (for live push mode) ─────────────────────────────────────────────
# URL of your deployed Cloudflare Worker
WORKER_URL=https://cex-spread-scanner.your-subdomain.workers.dev

# Secret token — must match what you set with: npx wrangler secret put COLLECTOR_TOKEN
COLLECTOR_TOKEN=change_me_to_a_strong_random_secret

# ── Optional ───────────────────────────────────────────────────────────────────
# Set to "true" to run without pushing: prints spreads to stdout instead
LOCAL_ONLY=false

# How often (seconds) to compute spreads and push to the worker (default: 5)
PUSH_INTERVAL_SECS=5

# Minimum 24h quote volume in millions USD per exchange to include a pair (default: 10)
MIN_VOL_MILLIONS=10

# Tracing/log level: error | warn | info | debug | trace (default: info)
RUST_LOG=info
