[Unit]
Description=VPS API Service for Crypto Arb
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/core-node
EnvironmentFile=/etc/vps-api.env
ExecStart=/usr/local/bin/vps-api
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vps-api

[Install]
WantedBy=multi-user.target
