[Unit]
Description=CEX Arbitrage Rust Collector
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/rust-collector
ExecStart=/usr/local/bin/rust-collector
Restart=always
RestartSec=5
EnvironmentFile=/etc/rust-collector.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
