# Port for the paper-trader HTTP server
PAPER_TRADER_PORT=3001

# Shared secret between Cloudflare Worker and paper-trader
# Must match PAPER_TRADER_TOKEN wrangler secret
INTERNAL_TOKEN=change_me_to_a_long_random_string

# Cloudflare Worker URL — used to archive closed trades to D1
WORKER_URL=https://cex-spread-scanner.workers.dev

# Token used to call Worker's /api/archive endpoint
COLLECTOR_TOKEN=same_as_rust_collector_token

# SQLite database path
DB_PATH=./trades.db

# Log level
RUST_LOG=info
