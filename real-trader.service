[Unit]
Description=CEX Arbitrage Real Trader Engine
Documentation=https://github.com/bagow/cex-arb
# Wait for network AND time sync — clock drift kills HTX HMAC signatures
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=opc
# Working dir must be where real-trader.db lives
WorkingDirectory=/home/opc/real-trader
ExecStart=/usr/local/bin/real-trader

# Restart policy: give up after 5 restarts in 60s to avoid infinite crash loops
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Environment — secrets live in /etc/real-trader.env (chmod 600, owned by opc)
EnvironmentFile=/etc/real-trader.env

# Safety limits
# Prevent OOM from killing the process silently
OOMScoreAdjust=-500
# Limit open files (WebSocket connections)
LimitNOFILE=65536

# Logging — redirect stdout/stderr to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=real-trader

[Install]
WantedBy=multi-user.target
